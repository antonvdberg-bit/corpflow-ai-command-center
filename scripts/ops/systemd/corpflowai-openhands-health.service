[Unit]
# CorpFlowAI — OpenHands private worker health-check unit (oneshot)
#
# STATUS: INACTIVE. DO NOT ENABLE without separate authorization. See
# ops/openhands/README.md and issue #743. Pairs with
# corpflowai-openhands-health.timer, which is ALSO not enabled (Phase 2+).
Description=CorpFlowAI OpenHands health check (oneshot; INACTIVE — do not enable, see issue #743)
Documentation=file:///home/anton/corpflow-ai-command-center/ops/openhands/README.md
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/corpflow-ai-command-center
# Optional Telegram alert env (same convention as
# scripts/ops/systemd/corpflowai-ops-backup-health.service). Alerts remain
# OFF by default even if this file is later enabled, unless
# OPENHANDS_ALERTS_ENABLED=1 is set in this env file.
EnvironmentFile=-%h/corpflow-ai-command-center/ops/openhands/.env
ExecStart=/usr/bin/bash %h/corpflow-ai-command-center/scripts/ops/openhands/health-check.sh
Nice=10

# Do not put secrets in this unit file. Success is silent; failure exits
# non-zero (journal + optional Telegram from the script itself).
