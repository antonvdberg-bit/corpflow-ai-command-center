[Unit]
# CorpFlowAI — OpenHands combined resource ceiling (systemd slice)
#
# STATUS: INACTIVE. DO NOT ENABLE without separate authorization. Issue #743.
#
# Intent: MemoryMax=8G / CPUQuota=300% / TasksMax=2048 as a HARD backstop for
# the dedicated rootless dockerd unit (Slice=corpflowai-openhands.slice) and,
# *if* cgroup v2 delegation places container processes under that service's
# cgroup tree, for sandboxes spawned by that daemon.
#
# CLAIM STATUS (honest): PENDING RUNTIME VERIFICATION.
# We EXPECT descendant container processes to remain under this slice when:
#   - cgroup v2 is in use;
#   - corpflowai-openhands-dockerd.service has Delegate=yes;
#   - the dockerd unit sets Slice=corpflowai-openhands.slice;
# but this package does NOT treat that as proven until the install-gate
# disposable-container cgroup inspection in
# docs/operations/OPENHANDS_DOCKER_ISOLATION.md passes on the real host.
# Until then, treat MemoryMax here as "dockerd service ceiling + expected
# sandbox containment," not as a fully certified guarantee.
Description=CorpFlowAI OpenHands combined resource ceiling (INACTIVE — pending runtime verification of sandbox cgroup placement, see issue #743)
Documentation=file:%h/corpflow-ai-command-center/docs/operations/OPENHANDS_DOCKER_ISOLATION.md

[Slice]
MemoryMax=8G
MemoryHigh=7G
CPUQuota=300%
TasksMax=2048
