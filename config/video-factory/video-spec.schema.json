{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://corpflowai.com/schemas/video-factory/video-spec.v1.json",
  "title": "CorpFlowAI Video Spec v1",
  "description": "Machine-executable production spec for a single Website Rescue (or later product) video. Phase A (#1143 / #1078) is zero-spend: specs are validated and mocked; live HeyGen calls are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "status",
    "phase",
    "role",
    "source",
    "purpose",
    "product",
    "cta",
    "duration",
    "picture",
    "avatar",
    "voice",
    "pronunciation",
    "script",
    "scenes",
    "captions",
    "on_screen_text",
    "assets",
    "claims",
    "privacy",
    "youtube_metadata_draft",
    "thumbnail",
    "publication"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "corpflow.video_spec.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^cf-vid-wr-[a-z0-9-]+$",
      "description": "Stable catalog id for Website Rescue Phase A videos."
    },
    "title": { "type": "string", "minLength": 8 },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved_for_mock",
        "blocked_pending_phase_b",
        "approved_for_calibration",
        "deprecated"
      ]
    },
    "phase": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E"]
    },
    "role": {
      "type": "string",
      "enum": ["launch", "calibration"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issues", "buyer_path_record", "recording_matrix_issue"],
      "properties": {
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "buyer_path_record": { "type": "string", "minLength": 8 },
        "recording_matrix_issue": { "type": "integer", "minimum": 1 },
        "supersedes": {
          "type": "array",
          "items": { "type": "string", "minLength": 4 }
        }
      }
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buyer", "problem", "outcome", "buyer_action"],
      "properties": {
        "buyer": { "type": "string", "minLength": 8 },
        "problem": { "type": "string", "minLength": 8 },
        "outcome": { "type": "string", "minLength": 8 },
        "buyer_action": { "type": "string", "minLength": 8 }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "named_landing_url",
        "demo_url",
        "enquiry_url",
        "sku_lock",
        "forbidden_recording_urls"
      ],
      "properties": {
        "name": { "type": "string", "const": "Website Rescue" },
        "named_landing_url": {
          "type": "string",
          "const": "https://corpflowai.com/website-rescue"
        },
        "demo_url": {
          "type": "string",
          "const": "https://corpflowai.com/demo/website-rescue"
        },
        "enquiry_url": {
          "type": "string",
          "enum": [
            "https://corpflowai.com/website-rescue#discovery",
            "https://corpflowai.com/contact?offer=premium-landing-page-rescue#discovery"
          ]
        },
        "sku_lock": {
          "type": "string",
          "const": "premium-landing-page-rescue"
        },
        "forbidden_recording_urls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 12, "pattern": "^https://" }
        }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "spoken", "destination_url"],
      "properties": {
        "label": { "type": "string", "const": "Request discovery" },
        "spoken": { "type": "string", "minLength": 8 },
        "destination_url": {
          "type": "string",
          "const": "https://corpflowai.com/website-rescue"
        }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_seconds_min", "target_seconds_max", "planned_seconds"],
      "properties": {
        "target_seconds_min": { "type": "number", "minimum": 5, "maximum": 180 },
        "target_seconds_max": { "type": "number", "minimum": 5, "maximum": 180 },
        "planned_seconds": { "type": "number", "minimum": 5, "maximum": 180 }
      }
    },
    "picture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratio", "resolution", "fps", "format"],
      "properties": {
        "aspect_ratio": { "type": "string", "enum": ["16:9", "9:16", "1:1"] },
        "resolution": { "type": "string", "pattern": "^[0-9]{3,4}x[0-9]{3,4}$" },
        "fps": { "type": "integer", "enum": [24, 25, 30, 60] },
        "format": { "type": "string", "const": "mp4" }
      }
    },
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment", "id", "style", "profile_ref"],
      "properties": {
        "assignment": {
          "type": "string",
          "enum": ["pending_anton_assignment", "fixed"]
        },
        "id": {
          "type": ["string", "null"],
          "description": "Exact HeyGen avatar_id when assigned. Null or PENDING_ANTON_AVATAR_ID until Phase B."
        },
        "style": { "type": "string", "const": "normal" },
        "profile_ref": { "type": "string", "minLength": 8 }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment", "id", "locale", "pace_wpm", "guide_ref"],
      "properties": {
        "assignment": {
          "type": "string",
          "enum": ["pending_anton_assignment", "fixed"]
        },
        "id": { "type": ["string", "null"] },
        "locale": { "type": "string", "const": "en-US" },
        "pace_wpm": { "type": "integer", "minimum": 110, "maximum": 160 },
        "guide_ref": { "type": "string", "minLength": 8 }
      }
    },
    "pronunciation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "say"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "say": { "type": "string", "minLength": 1 }
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "full_text", "word_count", "disclosures"],
      "properties": {
        "language": { "type": "string", "const": "en" },
        "full_text": { "type": "string", "minLength": 40 },
        "word_count": { "type": "integer", "minimum": 20 },
        "disclosures": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 4 }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_seconds",
          "duration_seconds",
          "purpose",
          "spoken_text",
          "visual",
          "source_screen"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^sc[0-9]{2}$" },
          "start_seconds": { "type": "number", "minimum": 0 },
          "duration_seconds": { "type": "number", "minimum": 2, "maximum": 40 },
          "purpose": { "type": "string", "minLength": 4 },
          "spoken_text": { "type": "string", "minLength": 8 },
          "visual": { "type": "string", "minLength": 8 },
          "source_screen": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "show", "do_not_show"],
            "properties": {
              "name": { "type": "string", "minLength": 2 },
              "url": { "type": "string", "minLength": 1 },
              "in_page_target": { "type": "string" },
              "show": { "type": "string", "minLength": 4 },
              "do_not_show": { "type": "string", "minLength": 4 }
            }
          }
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "source", "burn_in", "language"],
      "properties": {
        "required": { "type": "boolean", "const": true },
        "source": { "type": "string", "enum": ["script", "vtt"] },
        "burn_in": { "type": "boolean" },
        "language": { "type": "string", "const": "en" }
      }
    },
    "on_screen_text": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at_seconds", "text", "role"],
        "properties": {
          "at_seconds": { "type": "number", "minimum": 0 },
          "text": { "type": "string", "minLength": 2 },
          "role": {
            "type": "string",
            "enum": ["lower_third", "caption", "cta", "disclosure", "product_name"]
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen_recordings", "stills", "b_roll"],
      "properties": {
        "screen_recordings": {
          "type": "array",
          "items": { "type": "string", "minLength": 4 }
        },
        "stills": {
          "type": "array",
          "items": { "type": "string", "minLength": 4 }
        },
        "b_roll": {
          "type": "array",
          "items": { "type": "string", "minLength": 4 }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "forbidden",
        "required_trust_line",
        "no_invented_proof",
        "no_revenue_guarantee"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 4 }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 4 }
        },
        "required_trust_line": { "type": "string", "minLength": 12 },
        "no_invented_proof": { "type": "boolean", "const": true },
        "no_revenue_guarantee": { "type": "boolean", "const": true }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_client_data",
        "real_tenant_used",
        "real_pii",
        "fictional_demo_only",
        "do_not_submit_enquiry_on_camera"
      ],
      "properties": {
        "real_client_data": { "type": "boolean", "const": false },
        "real_tenant_used": { "type": "boolean", "const": false },
        "real_pii": { "type": "boolean", "const": false },
        "fictional_demo_only": { "type": "boolean", "const": true },
        "do_not_submit_enquiry_on_camera": { "type": "boolean", "const": true },
        "allowed_fictional_business": { "type": "string" }
      }
    },
    "youtube_metadata_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "tags", "chapters", "publication_status"],
      "properties": {
        "title": { "type": "string", "minLength": 8 },
        "description": { "type": "string", "minLength": 20 },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at_seconds", "label"],
            "properties": {
              "at_seconds": { "type": "number", "minimum": 0 },
              "label": { "type": "string", "minLength": 2 }
            }
          }
        },
        "publication_status": {
          "type": "string",
          "const": "do_not_publish"
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title_text", "must_include_product_name", "must_not_use_sku_title"],
      "properties": {
        "title_text": { "type": "string", "minLength": 4 },
        "must_include_product_name": { "type": "boolean", "const": true },
        "must_not_use_sku_title": { "type": "boolean", "const": true }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "website_embed",
        "youtube_upload",
        "auto_publish",
        "requires_anton_approval"
      ],
      "properties": {
        "website_embed": { "type": "boolean", "const": false },
        "youtube_upload": { "type": "boolean", "const": false },
        "auto_publish": { "type": "boolean", "const": false },
        "requires_anton_approval": { "type": "boolean", "const": true }
      }
    }
  }
}
