  "intent": "cipc-campaign",
  "owner_default": "Anton",
  "offer": {
    "headline": "Experienced Company Secretarial Operations Specialist available as fractional / white-label capacity behind accounting and advisory firms.",
    "do_not_lead_with": [
      "looking for remote work",
      "CIPC clerk",
      "commodity filing language",
      "job hunt"
    ]
  },
  "control_flow": [
    "prospect_verified",
    "segment_assigned",
    "fit_scored",
    "decision_maker_verified",
    "message_drafted",
    "operator_approved",
    "ready_to_send",
    "sent",
    "replied",
    "qualified",
    "nurture",
    "closed"
  ],
  "terminal_states": ["qualified", "nurture", "closed"],
  "protected_states": ["sent"],
  "scoring": {
    "existing_secretarial_cipc_client_base": 25,
    "accounting_advisory_serving_smes": 20,
    "remote_cloud_delivery_normal": 15,
    "boutique_specialist_headcount_inefficient": 15,
    "explicit_secretarial_likely_capacity_need": 10,
    "clear_owner_partner_decision_maker": 10,
    "existing_outsourcing_extension_language": 5,
    "max": 100
  },
  "segments": {
    "A": {
      "label": "Accounting / advisory firms — PRIMARY",
      "message_version": "segment-a-v1",
      "hypothesis": "Their clients already need the work; senior staff should not absorb routine statutory administration; outsourcing avoids permanent headcount; white-label can extend their catalogue."
    },
    "B": {
      "label": "Company-secretarial / governance firms — SECONDARY",
      "message_version": "segment-b-v1",
      "hypothesis": "Do not sell the existence of the service. Sell additional remote overflow / subcontracting capacity when workload spikes."
    },
    "C": {
      "label": "Current vacancies — MARKET INTELLIGENCE",
      "message_version": "segment-c-v1",
      "hypothesis": "Use vacancy language to improve offer design. Do not default to applying for jobs."
    }
  },
  "message_frameworks": {
    "A": {
      "version": "segment-a-v1",
      "subject": "Fractional company-secretarial capacity behind {company}",
      "hook": "You already offer company-secretarial / CIPC support. This note is about specialist capacity behind that service — not a new product for your clients to buy from someone else.",
      "problem": "Statutory administration still lands on the practice. Senior accounting time is the expensive way to cover it, and a permanent specialist is often the wrong headcount decision.",
      "mechanism": "Experienced fractional / white-label company-secretarial operations sit behind your firm: CIPC administration, statutory registers, beneficial ownership, director and shareholder changes, resolutions, minutes, and compliance calendars.",
      "proof": "More than 15 years of company-secretarial and governance operations, including work inside a publicly listed South African company. Exact public wording remains subject to confirmation.",
      "cta": "If a short conversation would help you decide whether overflow / white-label support is useful, reply to this note or use the partner path.",
      "validation_asset": "https://cipc.corpflowai.com/partners",
      "follow_up": [
        "Checking whether overflow / white-label company-secretarial capacity is useful behind your current client work.",
        "Happy to stay in the background of the practice — your clients stay yours.",
        "If timing is wrong, say so and I will close the loop rather than keep chasing."
      ]
    },
    "B": {
      "version": "segment-b-v1",
      "subject": "Remote overflow capacity for {company}",
      "hook": "You already run company-secretarial / governance work. This is additional specialist capacity for spikes — not a pitch to replace your service.",
      "problem": "Workload clusters. Permanent extra headcount is slow. Overflow still has to be done to the same standard.",
      "mechanism": "Experienced remote overflow / subcontracting capacity for statutory administration, registers, beneficial ownership, director/shareholder changes, resolutions and minutes.",
      "proof": "More than 15 years of company-secretarial and governance operations, including work inside a publicly listed South African company. Exact public wording remains subject to confirmation.",
      "cta": "If overflow cover would help on the next spike, reply and we can scope a quiet white-label arrangement.",
      "validation_asset": "https://cipc.corpflowai.com/partners",
      "follow_up": [
        "Following up only on overflow / subcontracting capacity, not on selling you a new service line.",
        "Delivery can stay behind your firm’s name.",
        "If you are fully covered, I will mark do-not-contact and stop."
      ]
    },
    "C": {
      "version": "segment-c-v1",
      "subject": null,
      "hook": "Vacancy language is market intelligence only.",
      "problem": "",
      "mechanism": "",
      "proof": "",
      "cta": "Do not send. Capture terminology, skills, and role signals.",
      "validation_asset": "https://cipc.corpflowai.com/partners",
      "follow_up": []
    }
  },
