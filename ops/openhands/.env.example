# OpenHands private worker — placeholder env template. STATUS: INACTIVE.
#
# Copy to a real ".env" ONLY at an Anton-approved install step, and fill
# values from an approved secret store (never from chat, issues, PRs, or
# this repository). Never commit a filled-in ".env" file.
#
# This template must NEVER contain a real value, and must NEVER gain a
# CorpFlowAI production secret name (POSTGRES_URL, DATABASE_URL,
# MASTER_ADMIN_KEY, CORPFLOW_AUTOMATION_*_SECRET, CORPFLOW_CRON_SECRET,
# CRON_SECRET, CURSOR_API_KEY, GITHUB_TOKEN, GROQ_API_KEY,
# TELEGRAM_BOT_TOKEN, VERCEL_TOKEN — see lib/openhands/package-policy.js
# FORBIDDEN_ENV_NAMES). This package does not read, forward, or reference
# any CorpFlowAI production secret.
#
# Controlling issue: #743. Security follow-up for PR #747 (dedicated Docker
# isolation design) — see docs/operations/OPENHANDS_DOCKER_ISOLATION.md and
# ops/openhands/compose.yaml's "DOCKER ISOLATION DESIGN" header.

# ---------------------------------------------------------------------------
# Dedicated Docker daemon (security follow-up for PR #747 — REQUIRED reading:
# docs/operations/OPENHANDS_DOCKER_ISOLATION.md before changing any of these).
# ---------------------------------------------------------------------------
#
# OpenHands (this package's control plane AND every sandbox container it
# spawns) MUST use a SEPARATE, DEDICATED, rootless Docker daemon — never the
# primary host daemon at /var/run/docker.sock. The defaults below (matching
# scripts/ops/openhands/lib/common.sh) are safe to leave as-is for a normal
# single-operator install; override ONLY if you have a specific,
# documented reason (e.g. a non-default OPENHANDS_HOME location) — and even
# then, OPENHANDS_DOCKER_SOCK / OPENHANDS_DOCKER_HOST must still never
# resolve to /var/run/docker.sock. scripts/ops/openhands/lib/common.sh's
# openhands_assert_isolation_context() fails closed if they do.

# Base directory for everything OpenHands-related on this host: the
# dedicated daemon's socket, its --data-root, and the task workspace
# directory (if a bind mount is ever substituted for the named
# corpflowai-openhands-workspace volume). Default: $HOME/corpflowai-openhands.
# Leave unset to use that default — only set this if you have a specific
# reason to relocate the whole OpenHands tree.
# OPENHANDS_HOME=<REPLACE_ME_absolute_path_or_leave_unset_for_default>

# Host-side path to the DEDICATED daemon's Unix socket. Default:
# $OPENHANDS_HOME/docker/docker.sock. NEVER set this to
# /var/run/docker.sock — that is the FORBIDDEN primary host socket. Leave
# unset to use the default derived from OPENHANDS_HOME.
# OPENHANDS_DOCKER_SOCK=<REPLACE_ME_dedicated_socket_path_or_leave_unset_for_default>

# The DOCKER_HOST value every OpenHands docker/compose operation must use.
# Default: unix://$OPENHANDS_DOCKER_SOCK (derived automatically). NEVER set
# this to unix:///var/run/docker.sock or any value containing that path.
# Leave unset to use the default.
# OPENHANDS_DOCKER_HOST=<REPLACE_ME_unix_socket_url_or_leave_unset_for_default>

# Dedicated daemon's own --data-root. Default: $OPENHANDS_HOME/docker-data.
# NEVER /var/lib/docker (the primary daemon's data-root) — this is what
# makes the two daemons' image/container/volume state physically
# non-overlapping. Leave unset to use the default.
# OPENHANDS_DOCKER_DATA_ROOT=<REPLACE_ME_dedicated_data_root_or_leave_unset_for_default>

# ---------------------------------------------------------------------------
# Concurrency / cost / timeout policy — matches ops/openhands/compose.yaml
# ---------------------------------------------------------------------------

# Hard concurrency ceiling — one sandbox task at a time. Must stay 1 in v1
# (see docs/operations/OPENHANDS_OPERATING_RUNBOOK.md § 3 and
# lib/openhands/package-policy.js MAX_CONCURRENT_TASKS). Checked by
# scripts/ops/openhands/preflight.sh.
MAX_CONCURRENT_CONVERSATIONS=1

# Per-task wall-clock ceiling (seconds) and agent-loop iteration ceiling —
# bound cost and blast radius per task. See
# config/openhands/cost-policy.example.yaml.
SANDBOX_TIMEOUT=600
MAX_ITERATIONS=40

# Control-plane URL as seen from sandbox containers on corpflowai-openhands-net.
# Maps to AppServerConfig.web_url via OpenHands from_env(..., 'OH').
# REQUIRED: without this, LiveStatusAppConversationService falls back to
# http://host.docker.internal:{port} for the default MCP server URL and
# conversation setup returns agent-server HTTP 500 (MCP Connection Failure)
# under ExtraHosts=[]. Never host.docker.internal. Never a public hostname.
OH_WEB_URL=http://corpflowai-openhands-app:3000

# ---------------------------------------------------------------------------
# LLM provider selection for the OpenHands control plane. Placeholder only —
# no default provider is selected by this package.
# ---------------------------------------------------------------------------
LLM_PROVIDER=<REPLACE_ME_llm_provider_name>
LLM_MODEL=<REPLACE_ME_llm_model_name>
LLM_API_KEY=<ENTER_DIRECTLY_IN_APPROVED_SECRET_STORE>

# GitHub least-privilege access, scoped to this repository only. Created at
# the install gate by the operator — never generated or pasted by an agent.
GITHUB_APP_ID=<REPLACE_ME_github_app_id>
GITHUB_APP_PRIVATE_KEY_PATH=<REPLACE_ME_path_to_private_key_file_outside_repo>

# Monthly model-spend ceiling enforced by operator policy (see
# lib/openhands/package-policy.js MONTHLY_COST_CEILING_USD /
# COST_STOP_PCT / COST_FAIL_CLOSED_PCT). Not a secret; documented here so an
# installer sees the same number the policy module encodes.
OPENHANDS_MONTHLY_COST_CEILING_USD=25

# ---------------------------------------------------------------------------
# Explicit exclusions (defense-in-depth — checked by
# scripts/ops/openhands/verify-no-production-access.sh)
# ---------------------------------------------------------------------------
#
# This file must NEVER gain any of the following, at any time, for any
# reason:
#   - POSTGRES_URL / POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING / DATABASE_URL
#   - MASTER_ADMIN_KEY
#   - CORPFLOW_AUTOMATION_INGEST_SECRET / CORPFLOW_AUTOMATION_FORWARD_SECRET / CORPFLOW_AUTOMATION_FORWARD_URL
#   - CORPFLOW_CRON_SECRET / CRON_SECRET
#   - CURSOR_API_KEY / GITHUB_TOKEN (the fine-grained/App credential above is
#     scoped and named GITHUB_APP_* on purpose, not the org-wide GITHUB_TOKEN)
#   - GROQ_API_KEY / VERCEL_TOKEN
#   - TELEGRAM_BOT_TOKEN — if OPENHANDS_ALERTS_ENABLED=1 is ever set, it must
#     use a DEDICATED bot token, never this repo's own TELEGRAM_BOT_TOKEN
#     (same failure-domain isolation rule Uptime Kuma follows).
#   - host.docker.internal — REMOVED entirely from this package's design.
#     Do not reintroduce it here or in ops/openhands/compose.yaml without a
#     fresh, separate review (see docs/operations/OPENHANDS_DOCKER_ISOLATION.md).
#     Upstream image default SANDBOX_LOCAL_RUNTIME_URL=http://host.docker.internal
#     is overridden in compose.yaml to http://corpflowai-openhands-app:3000
#     (dedicated-network DNS; no host-gateway). See OPENHANDS_DOCKER_ISOLATION.md § 3.1.
#   - /var/run/docker.sock — the primary host socket is FORBIDDEN. Never set
#     OPENHANDS_DOCKER_SOCK, OPENHANDS_DOCKER_HOST, or DOCKER_HOST to this
#     path, under any spelling (unix://, bare path, or otherwise).
