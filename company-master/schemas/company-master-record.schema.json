{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpflowai.com/schemas/company-master-record.schema.json",
  "title": "CorpFlowAI Company Master Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company_id",
    "company_type",
    "jurisdiction",
    "lifecycle_status",
    "record_owner",
    "created_at",
    "updated_at",
    "next_review_date",
    "governed_fields",
    "assets",
    "evidence_requirements"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "company_id": {"type": "string", "pattern": "^cmp_[a-z0-9][a-z0-9_-]{2,63}$"},
    "tenant_id": {"type": ["string", "null"], "minLength": 1},
    "company_type": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 2},
    "lifecycle_status": {"type": "string"},
    "record_owner": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "next_review_date": {"type": "string", "format": "date"},
    "governed_fields": {
      "type": "array",
      "items": {"$ref": "#/$defs/governedField"}
    },
    "assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/assetRecord"}
    },
    "evidence_requirements": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceRequirement"}
    }
  },
  "$defs": {
    "governedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "field_key",
        "field_value",
        "information_domain",
        "canonical_source",
        "source_system",
        "sensitivity_classification",
        "publication_status",
        "verification_status",
        "approval_status",
        "effective_from",
        "record_owner"
      ],
      "properties": {
        "field_id": {"type": "string", "minLength": 1},
        "field_key": {"type": "string", "minLength": 1},
        "field_value": {},
        "information_domain": {"type": "string", "minLength": 1},
        "canonical_source": {"type": "string", "minLength": 1},
        "source_document_reference": {"type": ["string", "null"]},
        "source_system": {"type": "string", "minLength": 1},
        "sensitivity_classification": {"type": "string"},
        "publication_status": {"type": "string"},
        "verification_status": {"type": "string"},
        "verified_by": {"type": ["string", "null"]},
        "verified_at": {"type": ["string", "null"], "format": "date-time"},
        "approval_status": {"type": "string"},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "effective_from": {"type": "string", "format": "date-time"},
        "effective_to": {"type": ["string", "null"], "format": "date-time"},
        "change_reason": {"type": ["string", "null"]},
        "previous_value_reference": {"type": ["string", "null"]},
        "record_owner": {"type": "string", "minLength": 1}
      }
    },
    "assetRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_type",
        "logical_alias",
        "title",
        "storage_provider",
        "storage_object_id",
        "mime_type",
        "content_hash",
        "sensitivity_classification",
        "publication_status",
        "verification_status",
        "approval_status",
        "lifecycle_status",
        "version_number",
        "effective_from",
        "record_owner"
      ],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^ast_[a-z0-9][a-z0-9_-]{2,63}$"},
        "asset_type": {"type": "string"},
        "logical_alias": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "storage_provider": {"type": "string"},
        "storage_object_id": {"type": "string", "minLength": 1},
        "storage_location_reference": {"type": ["string", "null"]},
        "mime_type": {"type": "string", "minLength": 3},
        "file_extension": {"type": ["string", "null"]},
        "byte_size": {"type": ["integer", "null"], "minimum": 0},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "sensitivity_classification": {"type": "string"},
        "publication_status": {"type": "string"},
        "verification_status": {"type": "string"},
        "approval_status": {"type": "string"},
        "lifecycle_status": {"type": "string"},
        "version_number": {"type": "integer", "minimum": 1},
        "supersedes_asset_id": {"type": ["string", "null"]},
        "effective_from": {"type": "string", "format": "date-time"},
        "effective_to": {"type": ["string", "null"], "format": "date-time"},
        "expiry_date": {"type": ["string", "null"], "format": "date"},
        "uploaded_by": {"type": ["string", "null"]},
        "uploaded_at": {"type": ["string", "null"], "format": "date-time"},
        "verified_by": {"type": ["string", "null"]},
        "verified_at": {"type": ["string", "null"], "format": "date-time"},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "retention_class": {"type": ["string", "null"]},
        "record_owner": {"type": "string", "minLength": 1}
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_key",
        "requirement_reason",
        "conditional_rule",
        "evidence_status"
      ],
      "properties": {
        "requirement_key": {"type": "string", "minLength": 1},
        "requirement_reason": {"type": "string", "minLength": 1},
        "conditional_rule": {"type": "string", "minLength": 1},
        "evidence_status": {"type": "string"},
        "asset_id": {"type": ["string", "null"]},
        "document_reference": {"type": ["string", "null"]},
        "received_at": {"type": ["string", "null"], "format": "date-time"},
        "verified_at": {"type": ["string", "null"], "format": "date-time"},
        "verified_by": {"type": ["string", "null"]},
        "expiry_date": {"type": ["string", "null"], "format": "date"},
        "waiver_reason": {"type": ["string", "null"]},
        "waiver_approved_by": {"type": ["string", "null"]}
      }
    }
  }
}
